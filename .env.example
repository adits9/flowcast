# Defaults run a fictional demo campus, with local SQLite and in-process updates.
DEMO_MODE=true
CAMPUS_NAME=Northwood University
CAMPUS_TIMEZONE=America/Chicago
SIMULATION_INTERVAL=20
CHECKIN_EXPIRY_HOURS=3

# Optional services; Docker Compose supplies these automatically.
# DATABASE_URL=postgresql+psycopg://flowcast:password@localhost:5432/flowcast
# REDIS_URL=redis://localhost:6379/0

# Set a long random secret to enable protected occupancy/weather/event ingestion.
SENSOR_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
